rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function myCoach() { return get(/databases/$(database)/documents/users/$(me())).data.get('coachId', null); }
    function isMyClient(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.get('coachId', null) == me(); }
    function coachIdOk() {
      let c = request.resource.data.get('coachId', null);
      return c == resource.data.get('coachId', null) || c == null || (request.resource.data.get('joinedWithCode', '') != '' && get(/databases/$(database)/documents/invites/$(request.resource.data.joinedWithCode)).data.coachId == c);
    }
    match /users/{userId} {
      allow read: if signedIn() && (me() == userId || resource.data.get('coachId', null) == me());
      allow create: if signedIn() && me() == userId;
      allow update: if signedIn() && me() == userId && coachIdOk();
      match /{sub=**} { allow read, write: if signedIn() && me() == userId; }
    }
    match /users/{coachId}/appointments/{id} {
      allow read: if signedIn() && resource.data.clientId == me();
    }
    match /users/{coachId}/requests/{id} {
      allow read: if signedIn() && resource.data.athleteId == me();
      allow create: if signedIn() && request.resource.data.athleteId == me() && myCoach() == coachId;
      allow delete: if signedIn() && resource.data.athleteId == me() && resource.data.status == 'pending';
    }
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.coachId == me();
      allow update, delete: if signedIn() && resource.data.coachId == me();
    }
    match /plans/{planId} {
      allow read: if signedIn() && (resource.data.coachId == me() || resource.data.athleteId == me());
      allow create: if signedIn() && request.resource.data.coachId == me() && isMyClient(request.resource.data.athleteId);
      allow update: if signedIn() && resource.data.coachId == me() && request.resource.data.coachId == me() && isMyClient(request.resource.data.athleteId);
      allow delete: if signedIn() && resource.data.coachId == me();
    }
    match /sessions/{sessionId} {
      allow read: if signedIn() && (resource.data.athleteId == me() || resource.data.coachId == me());
      allow create: if signedIn() && request.resource.data.athleteId == me();
      allow update: if signedIn() && resource.data.athleteId == me() && request.resource.data.athleteId == me() && request.resource.data.coachId == resource.data.coachId;
      allow delete: if signedIn() && resource.data.athleteId == me();
    }
    // ---------------- gestionale palestra ----------------
    function gymDoc(g) { return get(/databases/$(database)/documents/gyms/$(g)).data; }
    function isStaff(g) { return signedIn() && me() in gymDoc(g).staff; }
    function isGymOwner(g) { return signedIn() && gymDoc(g).owner == me(); }
    match /gyms/{g} {
      allow read: if signedIn() && me() in resource.data.staff;
      allow create: if signedIn() && request.resource.data.owner == me() && request.resource.data.staff == [me()];
      allow update: if signedIn() && (resource.data.owner == me()
        || (me() in resource.data.staff && request.resource.data.owner == resource.data.owner
            && request.resource.data.staff == resource.data.staff));
      allow delete: if false;
      match /staffRequests/{uid} {
        allow create, read: if signedIn() && me() == uid;
        allow delete: if signedIn() && (me() == uid || isGymOwner(g));
        allow list: if isGymOwner(g);
      }
      match /members/{m} {
        allow read: if isStaff(g) || (signedIn() && resource.data.linkedUid == me());
        allow create, delete: if isStaff(g);
        allow update: if isStaff(g)
          || (signedIn() && resource.data.get('linkedUid', '') == ''
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid'])
              && request.resource.data.linkedUid == me())
          || (signedIn() && resource.data.get('linkedUid', '') == me()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qrToken', 'qrAt']));
        match /files/{f} { allow read, write: if isStaff(g); }
      }
      match /{coll}/{id} {
        allow read, write: if coll in ['priceList', 'subscriptions', 'payments', 'checkins'] && isStaff(g);
      }
    }
    match /gymCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == me();
      allow update, delete: if signedIn() && resource.data.owner == me();
    }
    match /cardLinks/{code} {
      allow get: if signedIn();
      allow create, update: if isStaff(request.resource.data.gymId);
      allow delete: if isStaff(resource.data.gymId);
    }
    match /coachVideos/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.coachId == me();
      allow delete: if signedIn() && resource.data.coachId == me();
    }
  }
}
